local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 1. SCREEN BUTTON CREATE KARNA
local ScreenGui = Instance.new("ScreenGui")
local MainButton = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

ScreenGui.Name = "DirectClickGui"
ScreenGui.Parent = playerGui
ScreenGui.ResetOnSpawn = false

MainButton.Name = "ForceSkipBtn"
MainButton.Parent = ScreenGui
MainButton.Size = UDim2.new(0, 140, 0, 50)
MainButton.Position = UDim2.new(0, 50, 0, 150)
MainButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainButton.TextColor3 = Color3.fromRGB(0, 255, 120) -- Greenish Text
MainButton.Text = "FORCE SKIP"
MainButton.TextSize = 18
MainButton.Font = Enum.Font.SourceSansBold
MainButton.Draggable = true -- Isse button kahi bhi move kar sakte ho

UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainButton

-- 2. DIRECT FIRE FUNCTION (Bina Screen Touch Wala)
local function fireTargetButton()
    -- Path: Jo tumne bataya tha
    local success, target = pcall(function()
        return playerGui.Rebirth.Main.Rebirth.Contents.Buttons.SkipRebirthButton.Btn_Skip
    end)

    if success and target then
        -- Step A: Target button ko focus/select karna
        local oldSelection = GuiService.SelectedObject
        GuiService.SelectedObject = target
        
        task.wait(0.02)

        -- Step B: Direct Internal Input bhejna (Return/Enter Key)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)

        -- Step C: Selection clear karna
        GuiService.SelectedObject = oldSelection
        print("Success: Button Direct Fire Ho Gaya!")
    else
        warn("Error: Skip Button nahi mila, path check karo!")
    end
end

-- 3. CLICK EVENT
MainButton.Activated:Connect(function()
    fireTargetButton()
end)

print("Script Loaded: FORCE SKIP button screen par aa gaya hai.")

-- 1. Main Rebirth Button ka path
local rebirthButton = game:GetService("Players").LocalPlayer.PlayerGui:WaitForChild("Rebirth").Main.Rebirth.Contents.Buttons.Btn_Rebirth

-- 2. Naya UI Create Karna (Mobile Friendly)
local ScreenGui = Instance.new("ScreenGui")
local FastRebirthBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

-- GUI ko CoreGui me daal rahe hain taaki reset hone par delete na ho
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.Name = "FastRebirthUI"

-- Button ke Looks aur Position (Screen ke right side me center ke paas)
FastRebirthBtn.Name = "FastRebirthBtn"
FastRebirthBtn.Parent = ScreenGui
FastRebirthBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25) -- Dark Background
FastRebirthBtn.Position = UDim2.new(0.85, 0, 0.45, 0) -- Right side center
FastRebirthBtn.Size = UDim2.new(0, 80, 0, 45) -- Mobile friendly size
FastRebirthBtn.Font = Enum.Font.SourceSansBold
FastRebirthBtn.Text = "Rebirth"
FastRebirthBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FastRebirthBtn.TextSize = 16.000
FastRebirthBtn.Active = true
FastRebirthBtn.Draggable = true -- Aap isko screen par kahin bhi move kar sakte hain

-- Button ke corners ko round karne ke liye
UICorner.Parent = FastRebirthBtn
UICorner.CornerRadius = UDim.new(0, 8)

-- 3. Click/Tap Karne Par Kya Hoga (Logic)
FastRebirthBtn.Activated:Connect(function()
    if rebirthButton then
        -- Rebirth button ke saare functions ko fire karega
        for _, connection in pairs(getconnections(rebirthButton.Activated)) do
            connection:Fire()
        end
        -- Visual feedback (Click karne par ek bar green flash hoga)
        FastRebirthBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        task.wait(0.1)
        FastRebirthBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        warn("Rebirth button nahi mila!")
    end
end)

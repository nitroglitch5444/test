local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 1. Pehle naya UI screen par layenge (Bina wait kiye)
local ScreenGui = Instance.new("ScreenGui")
local FastRebirthBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

-- CoreGui ke badle PlayerGui use kar rahe hain taaki har executor me dikhe
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.Name = "FastRebirthUI"
ScreenGui.ResetOnSpawn = false -- Character marne par button nahi hatega

-- Button Settings (Screen ke right side me center me dikhega)
FastRebirthBtn.Name = "FastRebirthBtn"
FastRebirthBtn.Parent = ScreenGui
FastRebirthBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
FastRebirthBtn.Position = UDim2.new(0.85, 0, 0.45, 0) 
FastRebirthBtn.Size = UDim2.new(0, 90, 0, 45) -- Thoda bada size mobile ke liye
FastRebirthBtn.Font = Enum.Font.GothamBold
FastRebirthBtn.Text = "REBIRTH"
FastRebirthBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FastRebirthBtn.TextSize = 14.000
FastRebirthBtn.Active = true
FastRebirthBtn.Draggable = true 

UICorner.Parent = FastRebirthBtn
UICorner.CornerRadius = UDim.new(0, 10)

-- 2. Game ke original Rebirth button ko background me find karne ka logic
local function fireRebirth()
    -- Har baar direct path check karega bina script ko freeze kiye
    local success, errMsg = pcall(function()
        local rebirthButton = LocalPlayer.PlayerGui.Rebirth.Main.Rebirth.Contents.Buttons.Btn_Rebirth
        if rebirthButton then
            for _, connection in pairs(getconnections(rebirthButton.Activated)) do
                connection:Fire()
            end
            -- Fallback agar pehla tarika game detect na kare
            for _, connection in pairs(getconnections(rebirthButton.MouseButton1Click)) do
                connection:Fire()
            end
        end
    end)
    
    if not success then
        print("Rebirth button abhi game me nahi mila: ", errMsg)
    end
end

-- 3. Tap karne par function call hoga
FastRebirthBtn.Activated:Connect(function()
    -- Visual indicator
    FastRebirthBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    
    fireRebirth()
    
    task.wait(0.1)
    FastRebirthBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
end)

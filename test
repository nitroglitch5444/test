local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")

print("[Script] Mobile Execution Started. Waiting 3 seconds...")

-- 3 Seconds ka clear delay
task.wait(3.0)

print("[Script] 3 Seconds complete. Firing button on Mobile...")

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local skipButton = playerGui:WaitForChild("Rebirth")
                            :WaitForChild("Main")
                            :WaitForChild("Rebirth")
                            :WaitForChild("Contents")
                            :WaitForChild("Buttons")
                            :WaitForChild("SkipRebirthButton")
                            :WaitForChild("Btn_Skip")

if skipButton and skipButton.AbsolutePosition then
    -- Button ke exact center pixel ka coordinates calculate karna
    local x = skipButton.AbsolutePosition.X + (skipButton.AbsoluteSize.X / 2)
    local y = skipButton.AbsolutePosition.Y + (skipButton.AbsoluteSize.Y / 2) + GuiService:GetGuiInset().Y
    
    -- Mobile Internal Touch Protocol (Ye camera bilkul nahi ghumata)
    -- State 0 = TouchBegan (Ungli touch hui)
    -- State 2 = TouchEnded (Ungli hat gayi)
    local touchId = 2002 -- Unique Touch Identifier for Mobile Engine
    
    VirtualInputManager:SendTouchEvent(touchId, 0, x, y)
    task.wait(0.05) -- Micro-delay complete touch register karne ke liye
    VirtualInputManager:SendTouchEvent(touchId, 2, x, y)
    
    print("[Mobile Success] Button successfully tapped at position:", x, y)
else
    warn("[Script Error] Mobile par button nahi mila ya visible nahi hai!")
end

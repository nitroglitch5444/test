local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")

print("[Script] Script execute ho gayi hai. 3 Seconds ka delay shuru...")

-- 1. Exact 3 Seconds Ka Delay
task.wait(3.0)

print("[Script] 3 Seconds poore hue! Button fire karne ki koshish kar rahe hain...")

-- 2. Target Button Path
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local skipButton = playerGui:WaitForChild("Rebirth")
                            :WaitForChild("Main")
                            :WaitForChild("Rebirth")
                            :WaitForChild("Contents")
                            :WaitForChild("Buttons")
                            :WaitForChild("SkipRebirthButton")
                            :WaitForChild("Btn_Skip")

if skipButton then
    print("[Direct Method] Button mil gaya. Internal target lock kiya ja raha hai...")

    -- Step 1: Roblox Selection system me is button ko select karwana
    local oldSelection = GuiService.SelectedObject
    GuiService.SelectedObject = skipButton
    
    task.wait(0.05) -- Engine ko target register karne ke liye safe micro-delay

    -- Step 2: UI engine ko direct 'Selection Click' input bhejna
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game) -- Enter Down
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game) -- Enter Up

    -- Step 3: Purani selection wapas restore karna
    GuiService.SelectedObject = oldSelection
    
    print("[Direct Method] Success! 3s delay ke baad button perfectly trigger ho gaya.")
else
    warn("[Script Error] Button nahi mila, path check karo.")
end

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- 3 Seconds ka waiting delay
task.wait(3.0)

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 10)

-- PC METHOD (SelectedObject - No changes)
local function runPCMethod(target)
    local oldSelection = GuiService.SelectedObject
    GuiService.SelectedObject = target
    task.wait(0.02)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    GuiService.SelectedObject = oldSelection
    print("PC Clicked Successfully")
end

-- MOBILE METHOD (Super Light-Weight Dynamic Tap)
local function runMobileMethod(target)
    if target and target.AbsolutePosition then
        -- Direct coordinates calculate karna bina delay ke
        local x = target.AbsolutePosition.X + (target.AbsoluteSize.X / 2)
        local y = target.AbsolutePosition.Y + (target.AbsoluteSize.Y / 2) + GuiService:GetGuiInset().Y
        
        -- Instant touch event bina variables fast load ke liye
        VirtualInputManager:SendTouchEvent(9999, 0, x, y)
        task.wait(0.02)
        VirtualInputManager:SendTouchEvent(9999, 2, x, y)
        print("Mobile Tapped Successfully at:", x, y)
    end
end

-- MAIN EXECUTION
if playerGui then
    -- Bilkul direct aur simple check taaki mobile executor crash na ho
    local rebirthButton = playerGui.Rebirth.Main.Rebirth.Contents.Buttons.Btn_Rebirth

    if rebirthButton then
        if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
            -- Phone par direct bina crash wala click
            runMobileMethod(rebirthButton)
        else
            -- PC par tumhara verified method
            runPCMethod(rebirthButton)
        end
    end
end
